{
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "version",
    "source",
    "generated_at"
  ],
  "title": "ContractMeta",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
