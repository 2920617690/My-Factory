{
  "$defs": {
    "CapabilityRef": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "version"
      ],
      "title": "CapabilityRef",
      "type": "object"
    },
    "EntityRef": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Entity Id",
          "type": "string"
        },
        "entity_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Entity Type",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "entity_type"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "ErrorEnvelope": {
      "additionalProperties": false,
      "properties": {
        "error_code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Error Code",
          "type": "string"
        },
        "category": {
          "enum": [
            "VALIDATION",
            "NOT_FOUND",
            "PERMISSION",
            "PLUGIN_ERROR",
            "RUNTIME_ERROR",
            "INTERNAL"
          ],
          "title": "Category",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "refs": {
          "$ref": "#/$defs/References"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "error_code",
        "category",
        "message",
        "refs"
      ],
      "title": "ErrorEnvelope",
      "type": "object"
    },
    "References": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        },
        "execution_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Execution Id",
          "type": "string"
        },
        "entity_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "trace_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        }
      },
      "required": [
        "task_id",
        "execution_id"
      ],
      "title": "References",
      "type": "object"
    },
    "TraceEntry": {
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Trace Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        },
        "execution_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Execution Id",
          "type": "string"
        },
        "entity_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Entity Id",
          "type": "string"
        },
        "capability": {
          "$ref": "#/$defs/CapabilityRef"
        },
        "plugin_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Plugin Id",
          "type": "string"
        },
        "plugin_version": {
          "title": "Plugin Version",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "status": {
          "enum": [
            "RUNNING",
            "COMPLETED",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        },
        "result": {
          "default": null,
          "title": "Result"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorEnvelope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "trace_id",
        "task_id",
        "execution_id",
        "entity_id",
        "capability",
        "plugin_id",
        "plugin_version",
        "start",
        "status"
      ],
      "title": "TraceEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "mf.execution.v1",
      "default": "mf.execution.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Task Id",
      "type": "string"
    },
    "execution_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Execution Id",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/EntityRef"
    },
    "status": {
      "enum": [
        "COMPLETED",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    },
    "output": {
      "default": null,
      "title": "Output"
    },
    "state_effects": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "State Effects",
      "type": "array"
    },
    "trace": {
      "items": {
        "$ref": "#/$defs/TraceEntry"
      },
      "title": "Trace",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorEnvelope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "task_id",
    "execution_id",
    "target",
    "status",
    "trace"
  ],
  "title": "ExecutionResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
